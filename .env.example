# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google reCAPTCHA v2 (OBAVEZNO za produkciju!)
# Get your site key from: https://www.google.com/recaptcha/admin
# Type: reCAPTCHA v2 Checkbox (NOT Invisible or v3)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# IMPORTANT SECURITY NOTES:
# 1. Never commit .env files to git (already in .gitignore)
# 2. SUPABASE_ANON_KEY is safe to expose on frontend (it's public)
# 3. Never expose SUPABASE_SERVICE_ROLE_KEY on frontend
# 4. Use different keys for development and production
# 5. Rotate keys regularly (every 90 days)
# 6. Keep backups of old keys for 30 days

# ANTI-SPAM CONFIGURATION:
# 7. reCAPTCHA is MANDATORY for registration in production
# 8. Email verification MUST be enabled in Supabase Dashboard
# 9. Test with: test@mailinator.com should be BLOCKED
# 10. Honeypot fields are automatically active (no config needed)
